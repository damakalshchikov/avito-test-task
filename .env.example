# Host-порт Postgres
POSTGRES_PORT=5432

# kitchen (основной сервис)
KITCHEN_HTTP_ADDR=:8080
KITCHEN_DATABASE_URL=postgres://kitchen:kitchen@postgres:5432/kitchen?sslmode=disable
KITCHEN_ADMIN_TOKEN=dev-admin-token
KITCHEN_LOG_LEVEL=info
KITCHEN_OUTBOX_POLL_INTERVAL=1s

# restaurant (сервис-пример заведения)
RESTAURANT_HTTP_PORT=8090
RESTAURANT_KITCHEN_BASE_URL=http://kitchen:8080
RESTAURANT_API_KEY=demo-restaurant-key
RESTAURANT_PUBLIC_URL=http://restaurant:8090
RESTAURANT_AUTO_ACCEPT=true
RESTAURANT_SIMULATION_STEP_SECONDS=5
